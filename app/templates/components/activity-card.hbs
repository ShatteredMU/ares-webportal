<div class="activity-card">
  <div class="activity-card-header">
    <RecentChangeLink @change={{this.change}} />

    {{#if this.change.summary}}
      <a data-bs-toggle="collapse" href="#{{this.change.type}}-{{this.change.data.class_id}}" class="recent-activity-summary-tool">
        <TooltipIcon @position="right" @message="Expand details." @icon="fa fa-caret-square-down" />
      </a>
      <div id="{{this.change.type}}-{{this.change.data.class_id}}" class="card-collapse collapse recent-activity-summary">
        <AnsiFormat @text={{this.change.summary}} />
      </div>
    {{/if}}
  </div>

  <div class="activity-card-footer">
    Change to {{this.change.type}} by {{this.change.author}} on {{this.change.timestamp}}.
  </div>
</div>