<div class="activity-card">
  <RecentChangeLink @change={{change}} />
  {{#if change.summary}}
    <a data-bs-toggle="collapse" href="#{{change.type}}-{{change.data.class_id}}" class="recent-changes-summary-tool">
      Details <TooltipIcon @position="right" @message="Expand details." @icon="fa fa-caret-square-down" />
    </a>
    <div id="{{change.type}}-{{change.data.class_id}}" class="card-collapse collapse recent-changes-summary">
      <AnsiFormat @text={{change.summary}} />
    </div>
  {{/if}}
  {{#if (eq change.type 'char')}}
    <LinkTo @route="char-source" @models={{array change.data.char_name change.data.version_id}}>(history)</LinkTo>
  {{else if (eq change.type 'wiki')}}
    <LinkTo @route="wiki-source" @models={{array change.data.page_name change.data.version_id}}>(history)</LinkTo>
  {{/if}}
  <div class="activity-card-footer">
    Change to {{change.type}} by {{change.author}} on {{change.timestamp}}.
  </div>
</div>